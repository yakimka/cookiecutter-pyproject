FROM ghcr.io/umputun/ralphex:latest AS ralphex
FROM mcr.microsoft.com/devcontainers/python:3-3.13-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONASYNCIODEBUG=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100 \
    POETRY_VERSION=2.4.1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false


USER root

RUN mkdir /opt/venv /opt/code && chown vscode:vscode /opt/venv /opt/code

RUN rm -f /etc/apt/sources.list.d/yarn.list \
  && apt-get update \
  && apt-get install --no-install-recommends -y  \
    make \
    git \
    fzf \
    tmux \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    poetry==${POETRY_VERSION} poetry-plugin-export==1.10.* \
    && ln -s /usr/bin/gpg /usr/local/bin/gpg

COPY --from=ralphex /srv/ralphex /usr/local/bin/ralphex
RUN chmod +x /usr/local/bin/ralphex

USER vscode
ENV VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/venv/bin:$PATH"
# This creates /home/vscode/.vscode-server owned by vscode in the image layer.
# When Docker initializes the anonymous volume, it copies ownership from that
# image directory, so VS Code server can write to it immediately —
# before any lifecycle commands run.
RUN mkdir -p /home/vscode/.vscode-server

WORKDIR /opt/code
# `poetry.loc[k]` is a glob that makes the lock file optional, so the image
# still builds on a freshly generated project that has no lock file yet.
COPY --chown=vscode:vscode pyproject.toml poetry.loc[k] /opt/code/
RUN cd /opt/code && poetry install --no-root
